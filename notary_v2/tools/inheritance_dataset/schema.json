{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/inheritance-family.schema.json",
  "title": "Inheritance dataset family file",
  "type": "object",
  "required": ["family", "cases"],
  "properties": {
    "family": {"type": "string", "pattern": "^(?:F[0-9]{2}|_smoke)$"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "position": {"type": "integer", "minimum": 1, "maximum": 3},
    "node": {
      "type": "object",
      "required": ["id", "personId", "parentSlotIds", "spouseSlotId", "ownPositions", "receivePositions", "hidden", "deleted"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "personId": {"type": "string", "minLength": 1},
        "parentSlotIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "spouseSlotId": {"type": ["string", "null"]},
        "ownPositions": {"type": "array", "items": {"$ref": "#/$defs/position"}, "uniqueItems": true},
        "receivePositions": {"type": "array", "items": {"$ref": "#/$defs/position"}, "uniqueItems": true},
        "hidden": {"type": "boolean"},
        "deleted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "family", "title", "rules", "asset_count", "meta", "people", "diagram", "action", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "pattern": "^(?:F[0-9]{2}|_smoke)$"},
        "title": {"type": "string"},
        "rules": {"type": "array", "items": {"type": "string", "pattern": "^R-[0-9]{2}$"}},
        "asset_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "meta": {
          "type": "object",
          "properties": {
            "opened_before_2017": {"type": "boolean"},
            "land_type": {"enum": ["ca_nhan", "ho_gia_dinh"]},
            "parcels_per_certificate": {"type": "integer", "minimum": 1},
            "liet_si_person_ids": {"type": "array", "items": {"type": "string"}},
            "children_count": {"type": "integer", "minimum": 0},
            "merged_estate": {"type": "boolean"},
            "parent_died_long_ago_person_ids": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "people": {"type": "object", "additionalProperties": {"type": "object", "required": ["ho_ten", "ngay_chet"], "properties": {"ho_ten": {"type": "string"}, "ngay_chet": {"type": ["string", "null"], "pattern": "^(?:[0-9]{2}/[0-9]{2}/[0-9]{4}|[0-9]{4})?$"}}, "additionalProperties": false}},
        "diagram": {"type": "object", "required": ["version", "domain", "nodes"], "properties": {"version": {"const": 3}, "domain": {"const": "inheritance"}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}}, "additionalProperties": false},
        "action": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["type", "nodeId"], "properties": {"type": {"const": "delete_root"}, "nodeId": {"type": "string"}}, "additionalProperties": false}]},
        "expected": {"type": "object", "required": ["status", "reasons", "shares", "unresolved", "remaining_node_ids", "pending_decision"], "properties": {"status": {"enum": ["complete", "incomplete", "unsupported", "invalid", "pending"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "shares": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fraction"}}}, "unresolved": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fraction"}}, "remaining_node_ids": {"type": ["array", "null"], "items": {"type": "string"}}, "pending_decision": {"type": ["string", "null"], "pattern": "^Q-[0-9]{3}$"}, "explanation": {"type": "string"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "fraction": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*)/[1-9][0-9]*$"}
  }
}
