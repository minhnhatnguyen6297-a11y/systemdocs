{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://systemdocs/contracts/notary-case-drafting/draft-v2.schema.json",
  "title": "notary.case-drafting.v2 — MIN-125 (APPROVED 27/09/2026)",
  "description": "Định nghĩa shape v2 cho §13 của contracts/notary-case-drafting.md. Đã được owner duyệt 27/09/2026; implement ở P5 (MIN-128). Normative text là §13 trong file contract — file này là tham chiếu hỗ trợ.",
  "definitions": {
    "word_options_result_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "documents"],
      "properties": {
        "schema_version": { "$ref": "#/definitions/schema_version_v2" },
        "documents": { "$ref": "word-export.schema.json#/definitions/options_result_data/properties/documents" },
        "binding_proposals": { "$ref": "word-export.schema.json#/definitions/options_result_data/properties/binding_proposals" }
      }
    },
    "schema_version_v2": {
      "type": "string",
      "const": "notary.case-drafting.v2"
    },
    "position_1_3": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "asset_row_v2": {
      "type": "object",
      "description": "Giống v1 asset_row nhưng KHÔNG có is_primary — vị trí = index+1 (§13.3). Storage B đang triển khai vòng 1: dữ kiện và land_rows thuộc dòng hồ sơ, không ghi đè master; thoi_han lẻ optional ở input, absent giữ giá trị của dòng hồ sơ.",
      "required": [
        "row_id", "entity_id", "so_serial", "so_vao_so",
        "so_thua_dat", "so_to_ban_do", "dia_chi", "loai_so",
        "hinh_thuc_su_dung", "nguon_goc", "ngay_cap",
        "co_quan_cap", "land_rows"
      ],
      "additionalProperties": false,
      "properties": {
        "row_id": { "$ref": "common.schema.json#/definitions/uuid4" },
        "entity_id": { "type": ["integer", "null"] },
        "so_serial": { "type": "string" },
        "so_vao_so": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "so_thua_dat": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "so_to_ban_do": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "dia_chi": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loai_so": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "hinh_thuc_su_dung": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "thoi_han": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "nguon_goc": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "ngay_cap": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "co_quan_cap": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "land_rows": {
          "type": ["array", "null"],
          "items": { "$ref": "#/definitions/land_row_v2" }
        }
      },
      "not": { "required": ["is_primary"] }
    },
    "land_row_v2": {
      "type": "object",
      "description": "Hàng loại đất cấu trúc: mục đích sử dụng + diện tích + thời hạn (§13.3)",
      "additionalProperties": false,
      "properties": {
        "loai_dat": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "dien_tich": { "type": ["number", "null"] },
        "thoi_han": { "$ref": "common.schema.json#/definitions/nullable_string" }
      }
    },
    "person_row_output_v2": {
      "type": "object",
      "description": "Person row phía output/result (vòng 2): ho_ten nullable vì nháp đã lưu có thể chưa có tên; KHÔNG dùng cho input strict.",
      "required": [
        "row_id", "entity_id", "ho_ten", "gioi_tinh", "ngay_sinh",
        "ngay_chet", "so_giay_to", "ngay_cap", "noi_cap", "dia_chi",
        "place_of_origin", "loai_giay_to", "loai_dia_chi"
      ],
      "additionalProperties": false,
      "properties": {
        "row_id": { "$ref": "common.schema.json#/definitions/uuid4" },
        "entity_id": { "type": ["integer", "null"], "minimum": 1 },
        "ho_ten": { "type": ["string", "null"], "minLength": 1 },
        "gioi_tinh": { "enum": ["Nam", "Nữ", null] },
        "ngay_sinh": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "ngay_chet": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "so_giay_to": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "ngay_cap": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "noi_cap": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "dia_chi": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "place_of_origin": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loai_giay_to": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loai_dia_chi": { "$ref": "common.schema.json#/definitions/nullable_string" }
      }
    },
    "person_row_create_v2": {
      "type": "object",
      "description": "Person row phía input của workspace_create partial (vòng 2): ho_ten null/absent được; canonical alias vẫn đọc được. KHÔNG dùng cho save_case/commit/evaluate strict.",
      "required": [
        "row_id", "entity_id", "gioi_tinh", "ngay_sinh",
        "ngay_chet", "so_giay_to", "ngay_cap", "noi_cap", "dia_chi",
        "place_of_origin", "loai_giay_to", "loai_dia_chi"
      ],
      "additionalProperties": false,
      "properties": {
        "row_id": { "$ref": "common.schema.json#/definitions/uuid4" },
        "entity_id": { "type": ["integer", "null"], "minimum": 1 },
        "ho_ten": { "type": ["string", "null"], "minLength": 1 },
        "gioi_tinh": { "enum": ["Nam", "Nữ", null] },
        "ngay_sinh": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "ngay_chet": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "so_giay_to": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "ngay_cap": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "noi_cap": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "dia_chi": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "place_of_origin": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loai_giay_to": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loai_dia_chi": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "ten": { "type": ["string", "null"], "minLength": 1 },
        "gioitinh": { "enum": ["Nam", "Nữ", null] },
        "ngaysinh": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "ngaychet": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "sogiayto": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "ngaycap": { "$ref": "common.schema.json#/definitions/date_or_year" },
        "noicap": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "diachi": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loaigiayto": { "$ref": "common.schema.json#/definitions/nullable_string" },
        "loaidiachi": { "$ref": "common.schema.json#/definitions/nullable_string" }
      }
    },
    "asset_row_output_v2": {
      "description": "Asset row phía output: asset_row_v2 + luôn emit `thoi_han` lẻ nullable để đối chiếu lịch sử/warning (§4.2).",
      "allOf": [
        { "$ref": "#/definitions/asset_row_v2" },
        { "required": ["thoi_han"] }
      ]
    },
    "stage_v2_output": {
      "type": "object",
      "description": "Stage phía output (§4, §13.20). owner_row_id nullable/absent: inheritance emit key (có thể null khi nháp chưa gán); two_party không key. people/assets có thể rỗng.",
      "required": ["people", "assets"],
      "additionalProperties": false,
      "properties": {
        "owner_row_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/definitions/uuid4" },
            { "type": "null" }
          ]
        },
        "people": {
          "type": "array",
          "items": { "$ref": "#/definitions/person_row_output_v2" }
        },
        "assets": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/definitions/asset_row_output_v2" }
        }
      }
    },
    "stage_v2_create": {
      "type": "object",
      "description": "Stage input của workspace_create partial (vòng 2): people/assets ≥0, tên null được, owner inheritance absent/null được. Save_case/commit dùng stage_v2 strict, không dùng definition này.",
      "required": ["people", "assets"],
      "additionalProperties": false,
      "properties": {
        "owner_row_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/definitions/uuid4" },
            { "type": "null" }
          ]
        },
        "people": {
          "type": "array",
          "items": { "$ref": "#/definitions/person_row_create_v2" }
        },
        "assets": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/definitions/asset_row_v2" }
        }
      }
    },
    "stage_v2": {
      "type": "object",
      "description": "Stage input STRICT cho commit_stage/save_case/evaluate hiện hành: person ho_ten non-empty; owner_row_id (nếu có) là UUID, luật theo domain do command áp. Không dùng cho workspace_create partial.",
      "required": ["people", "assets"],
      "additionalProperties": false,
      "properties": {
        "owner_row_id": {
          "$ref": "common.schema.json#/definitions/uuid4",
          "description": "BẮT BUỘC khi case_type=inheritance trong payload; CẤM khi two_party; result emit null cho legacy chưa có owner (§13.6)"
        },
        "people": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/person_row" },
          "description": "≤30 phần tử khi case_type=two_party (people_limit)"
        },
        "assets": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/definitions/asset_row_v2" },
          "description": "vị trí = index+1; ≤3 → asset_limit (§13.3)"
        }
      }
    },
    "node_v3_inheritance": {
      "type": "object",
      "required": [
        "id", "personId", "parentSlotIds", "spouseSlotId",
        "ownPositions", "receivePositions", "hidden", "deleted"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "personId": {
          "oneOf": [
            { "$ref": "common.schema.json#/definitions/uuid4" },
            { "type": "null" }
          ]
        },
        "parentSlotIds": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "spouseSlotId": { "type": ["string", "null"], "minLength": 1 },
        "ownPositions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/position_1_3" }
        },
        "receivePositions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/position_1_3" }
        },
        "hidden": { "type": "boolean" },
        "deleted": { "type": "boolean" }
      }
    },
    "node_v3_two_party": {
      "type": "object",
      "required": ["id", "personId", "hidden", "deleted"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p([1-9]|[12][0-9]|30)$",
          "description": "p1..p30 cố định; p≤15 = bên A, p≥16 = bên B (§13.5)"
        },
        "personId": {
          "oneOf": [
            { "$ref": "common.schema.json#/definitions/uuid4" },
            { "type": "null" }
          ]
        },
        "hidden": { "type": "boolean" },
        "deleted": { "type": "boolean" }
      }
    },
    "diagram_state_v3": {
      "type": "object",
      "required": ["version", "domain", "nodes"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 3 },
        "domain": { "enum": ["inheritance", "two_party"] },
        "nodes": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "if": { "properties": { "domain": { "const": "two_party" } } },
      "then": {
        "properties": {
          "nodes": {
            "type": "array",
            "minItems": 30,
            "maxItems": 30,
            "items": { "$ref": "#/definitions/node_v3_two_party" },
            "description": "Canonical: đủ 30 node p1..p30 theo đúng thứ tự (§13.5)"
          }
        }
      },
      "else": {
        "properties": {
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/definitions/node_v3_inheritance" }
          }
        }
      }
    },
    "payload_workspace_create_v2": {
      "type": "object",
      "required": ["idempotency_key", "case", "stage"],
      "additionalProperties": false,
      "properties": {
        "idempotency_key": { "$ref": "common.schema.json#/definitions/uuid4" },
        "case": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "casetype": { "$ref": "#/definitions/payload_workspace_create_v2/properties/case/properties/case_type" },
            "documenttype": { "$ref": "#/definitions/payload_workspace_create_v2/properties/case/properties/document_type" },
            "ngaylaphoso": { "$ref": "common.schema.json#/definitions/date_full" },
            "noiniemyet": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nguoinhanuyquyen": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nguoinhanuyquyenid": { "type": ["integer", "null"], "minimum": 1 },
            "noidungviec": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "ghichu": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "tenvanban": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nhomhopdong": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "loaivanbannhandien": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "socongchung": { "type": ["string", "null"], "pattern": "^\\d+/\\d{4}$" },
            "ngaycongchung": { "$ref": "common.schema.json#/definitions/date_full" },
            "congchungvien": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "thuky": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "case_type": { "enum": ["inheritance", "two_party"] },
            "document_type": {
              "type": "string",
              "description": "inheritance: khai_nhan|thoa_thuan; two_party: chuyen_nhuong|tang_cho|cho_thue|dat_coc (Q11 — chờ owner)"
            },
            "ngay_lap_ho_so": { "$ref": "common.schema.json#/definitions/date_full" },
            "noi_niem_yet": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nguoi_nhan_uy_quyen": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nguoi_nhan_uy_quyen_id": { "type": ["integer", "null"], "minimum": 1 },
            "noi_dung_viec": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "ghi_chu": { "$ref": "common.schema.json#/definitions/nullable_string" }
          }
        },
        "stage": { "$ref": "#/definitions/stage_v2_create" },
        "diagram": {
          "type": "object",
          "description": "OPTIONAL ở v2 — absent thì server seed (§13.6)",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {
            "state": { "$ref": "#/definitions/diagram_state_v3" }
          }
        },
        "docx_import": {
          "$ref": "common.schema.json#/definitions/docx_import"
        }
      }
    },
    "payload_commit_stage_v2": {
      "type": "object",
      "required": ["case_id", "base_revision", "stage"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "integer", "minimum": 1 },
        "base_revision": { "type": "integer", "minimum": 1 },
        "case": {
          "type": "object",
          "additionalProperties": false,
          "description": "OPTIONAL — metadata hồ sơ ghi cùng Stage trong một transaction; case_type/document_type kèm theo phải khớp giá trị đã lưu. Chỉ dedicated workspace_convert_type (§13.18) được chuyển loại; commit vẫn immutable. Chấp nhận key canonical — §6.",
          "properties": {
            "tenvanban": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nhomhopdong": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "loaivanbannhandien": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "socongchung": { "type": ["string", "null"], "pattern": "^\\d+/\\d{4}$" },
            "ngaycongchung": { "$ref": "common.schema.json#/definitions/date_full" },
            "congchungvien": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "thuky": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "case_type": { "enum": ["inheritance", "two_party", null] },
            "document_type": { "type": ["string", "null"] },
            "ngay_lap_ho_so": { "$ref": "common.schema.json#/definitions/date_full" },
            "noi_niem_yet": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nguoi_nhan_uy_quyen": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "nguoi_nhan_uy_quyen_id": { "type": ["integer", "null"], "minimum": 1 },
            "noi_dung_viec": { "$ref": "common.schema.json#/definitions/nullable_string" },
            "ghi_chu": { "$ref": "common.schema.json#/definitions/nullable_string" }
          }
        },
        "stage": { "$ref": "#/definitions/stage_v2" },
        "docx_import": {
          "$ref": "common.schema.json#/definitions/docx_import"
        }
      }
    },
    "payload_diagram_save_v2": {
      "type": "object",
      "required": ["case_id", "base_revision", "diagram"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "integer", "minimum": 1 },
        "base_revision": { "type": "integer", "minimum": 1 },
        "diagram": {
          "type": "object",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {
            "state": { "$ref": "#/definitions/diagram_state_v3" }
          }
        }
      }
    }
  }
}
