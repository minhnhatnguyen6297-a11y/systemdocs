{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://systemdocs/contracts/notary-case-drafting/stage.schema.json",
  "title": "notary.workspace_commit_stage — payload + result.data",
  "definitions": {
    "payload": {
      "type": "object",
      "required": ["case_id", "base_revision", "stage"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "integer", "minimum": 1 },
        "base_revision": { "type": "integer", "minimum": 1 },
        "case": {
          "type": "object",
          "additionalProperties": false,
          "description": "OPTIONAL metadata cùng Stage trong một transaction; case_type/document_type gửi kèm phải khớp giá trị đã lưu (immutable qua commit). Chuyển loại chỉ qua workspace_convert_type §13.18. Server chấp nhận key canonical; hai spelling lệch → validation_error.",
          "properties": {
            "case_type": { "type": "string" },
            "document_type": { "enum": ["khai_nhan", "thoa_thuan", null] },
            "ngay_lap_ho_so": {
              "$ref": "common.schema.json#/definitions/date_full"
            },
            "noi_niem_yet": {
              "$ref": "common.schema.json#/definitions/nullable_string"
            },
            "nguoi_nhan_uy_quyen": {
              "$ref": "common.schema.json#/definitions/nullable_string"
            },
            "nguoi_nhan_uy_quyen_id": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "noi_dung_viec": {
              "$ref": "common.schema.json#/definitions/nullable_string"
            },
            "ghi_chu": {
              "$ref": "common.schema.json#/definitions/nullable_string"
            }
          }
        },
        "stage": { "$ref": "draft-v2.schema.json#/definitions/stage_v2" },
        "docx_import": {
          "$ref": "common.schema.json#/definitions/docx_import"
        }
      }
    },
    "result_data": {
      "type": "object",
      "required": ["schema_version", "revision", "stage", "diagram"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "draft-v2.schema.json#/definitions/schema_version_v2" },
        "revision": { "type": "integer", "minimum": 1 },
        "stage": { "$ref": "draft-v2.schema.json#/definitions/stage_v2_output" },
        "diagram": {
          "type": "object",
          "required": ["state", "render_model"],
          "additionalProperties": false,
          "properties": {
            "state": { "$ref": "draft-v2.schema.json#/definitions/diagram_state_v3" },
            "render_model": {
              "$ref": "common.schema.json#/definitions/render_model",
              "description": "non-null — re-evaluate trong cùng transaction (contract §6.1)"
            }
          }
        },
        "docx_import": {
          "$ref": "common.schema.json#/definitions/docx_import"
        }
      }
    }
  }
}
