{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://systemdocs/contracts/notary-case-drafting/diagram.schema.json",
  "title": "notary.diagram_evaluate + notary.diagram_save — payload + result.data",
  "definitions": {
    "evaluate_payload": {
      "type": "object",
      "required": ["diagram"],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "integer", "minimum": 1,
          "description": "rev 1.1: absent = chế độ nháp (khi đó stage bắt buộc); null → validation_error"
        },
        "stage": {
          "type": "object",
          "required": ["people", "assets"],
          "additionalProperties": false,
          "description": "rev 1.1: bắt buộc khi case_id absent; cấm khi case_id present",
          "properties": {
            "people": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/definitions/person_row" }
            },
            "assets": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/definitions/asset_row" }
            }
          }
        },
        "diagram": {
          "type": "object",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {
            "state": { "$ref": "common.schema.json#/definitions/diagram_state" }
          }
        }
      },
      "allOf": [
        {
          "if": { "not": { "required": ["case_id"] } },
          "then": { "required": ["stage"] }
        },
        {
          "if": { "required": ["case_id"] },
          "then": { "not": { "required": ["stage"] } }
        }
      ]
    },
    "evaluate_result_data": {
      "type": "object",
      "required": ["schema_version", "evaluated_revision", "render_model"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/definitions/schema_version" },
        "evaluated_revision": {
          "type": ["integer", "null"], "minimum": 1,
          "description": "rev 1.1: null trong chế độ nháp"
        },
        "render_model": { "$ref": "common.schema.json#/definitions/render_model" }
      }
    },
    "save_payload": {
      "type": "object",
      "required": ["case_id", "base_revision", "diagram"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "integer", "minimum": 1 },
        "base_revision": { "type": "integer", "minimum": 1 },
        "diagram": {
          "type": "object",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {
            "state": { "$ref": "common.schema.json#/definitions/diagram_state" }
          }
        }
      }
    },
    "save_result_data": {
      "type": "object",
      "required": ["schema_version", "revision", "diagram"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/definitions/schema_version" },
        "revision": { "type": "integer", "minimum": 1 },
        "diagram": {
          "type": "object",
          "required": ["state", "render_model"],
          "additionalProperties": false,
          "properties": {
            "state": { "$ref": "common.schema.json#/definitions/diagram_state" },
            "render_model": {
              "$ref": "common.schema.json#/definitions/render_model",
              "description": "non-null — save thành công luôn kèm evaluate"
            }
          }
        }
      }
    }
  }
}
