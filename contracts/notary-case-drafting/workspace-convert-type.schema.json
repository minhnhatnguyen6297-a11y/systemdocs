{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://systemdocs/contracts/notary-case-drafting/workspace-convert-type.schema.json",
  "title": "notary.workspace_convert_type — dedicated saved-case conversion (§13.18)",
  "definitions": {
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "base_revision", "case_type", "document_type", "confirm_diagram_reset"],
      "properties": {
        "case_id": {"type":"integer","minimum":1},
        "base_revision": {"type":"integer","minimum":1},
        "case_type": {"enum":["inheritance","two_party"]},
        "document_type": {"type":"string"},
        "confirm_diagram_reset": {"const":true},
        "owner_row_id": {"$ref":"common.schema.json#/definitions/uuid4"}
      },
      "allOf": [{
        "if": {"properties":{"case_type":{"const":"inheritance"}}},
        "then": {"required":["owner_row_id"],"properties":{"document_type":{"enum":["khai_nhan","thoa_thuan"]}}},
        "else": {"not":{"required":["owner_row_id"]},"properties":{"document_type":{"enum":["chuyen_nhuong","tang_cho","cho_thue","dat_coc"]}}}
      }]
    },
    "result_data": {
      "type":"object", "additionalProperties":false,
      "required":["schema_version","case","stage","diagram","capabilities"],
      "properties":{
        "schema_version":{"const":"notary.case-drafting.v2"},
        "backend_mode":{"enum":["real","mock"]},
        "case":{
          "type":"object",
          "required":["id","case_type","document_type","revision","status"],
          "properties":{
            "id":{"type":"integer","minimum":1},
            "case_type":{"enum":["inheritance","two_party"]},
            "document_type":{"enum":["khai_nhan","thoa_thuan","chuyen_nhuong","tang_cho","cho_thue","dat_coc"]},
            "revision":{"type":"integer","minimum":2},
            "status":{"enum":["draft","done"]}
          }
        },
        "stage":{"$ref":"draft-v2.schema.json#/definitions/stage_v2"},
        "diagram":{
          "type":"object","required":["domain","state","render_model"],
          "properties":{
            "domain":{"enum":["inheritance","two_party"]},
            "state":{"$ref":"draft-v2.schema.json#/definitions/diagram_state_v3"},
            "render_model":{"type":["object","null"]},
            "warnings":{"type":"array"}
          }
        },
        "capabilities":{"$ref":"workspace.schema.json#/definitions/result_data/properties/capabilities"},
        "docx_import":{"$ref":"common.schema.json#/definitions/docx_import"},
        "warnings":{"type":"array"}
      }
    }
  }
}
