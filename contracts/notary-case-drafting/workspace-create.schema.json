{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://systemdocs/contracts/notary-case-drafting/workspace-create.schema.json",
  "title": "notary.workspace_create — payload + result.data (rev 1.1, MIN-121)",
  "definitions": {
    "case_meta": {
      "type": "object",
      "required": ["document_type"],
      "additionalProperties": false,
      "properties": {
        "document_type": { "enum": ["khai_nhan", "thoa_thuan"] },
        "ngay_lap_ho_so": {
          "$ref": "common.schema.json#/definitions/date_full"
        },
        "noi_niem_yet": {
          "$ref": "common.schema.json#/definitions/nullable_string"
        },
        "nguoi_nhan_uy_quyen": {
          "$ref": "common.schema.json#/definitions/nullable_string",
          "description": "đợt 3 — optional; khi kèm nguoi_nhan_uy_quyen_id phải khớp tên master"
        },
        "nguoi_nhan_uy_quyen_id": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "đợt 3 — customers.id; id sai/không tồn tại → validation_error"
        },
        "noi_dung_viec": {
          "$ref": "common.schema.json#/definitions/nullable_string",
          "description": "đợt 3 — cụm nội dung việc"
        },
        "ghi_chu": {
          "$ref": "common.schema.json#/definitions/nullable_string"
        }
      }
    },
    "payload_v2": {
      "description": "Wrapper vòng 2 — payload workspace_create dùng stage partial (≥0, tên null, owner null) và diagram optional; mọi ràng buộc strict của save_case/commit không nằm ở đây.",
      "$ref": "draft-v2.schema.json#/definitions/payload_workspace_create_v2"
    },
    "payload": {
      "type": "object",
      "description": "Shape v1 lịch sử; v2 hiện hành dùng payload_v2/draft-v2.",
      "required": ["idempotency_key", "case", "stage", "diagram"],
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "$ref": "common.schema.json#/definitions/uuid4"
        },
        "case": { "$ref": "#/definitions/case_meta" },
        "stage": {
          "type": "object",
          "required": ["people", "assets"],
          "additionalProperties": false,
          "properties": {
            "people": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/definitions/person_row"
              },
              "description": "entity_id phải null (dòng mới)"
            },
            "assets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/definitions/asset_row_input"
              },
              "description": "đúng một is_primary:true; entity_id null. MIN-141: input không bắt buộc thoi_han lẻ"
            }
          }
        },
        "diagram": {
          "type": "object",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {
            "state": {
              "$ref": "common.schema.json#/definitions/diagram_state",
              "description": "personId tham chiếu row_id trong stage của cùng payload; node 'owner' bắt buộc đã gán"
            }
          }
        },
        "docx_import": {
          "$ref": "common.schema.json#/definitions/docx_import"
        }
      }
    },
    "result_data": {
      "type": "object",
      "required": [
        "schema_version", "created", "case", "stage", "diagram",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/definitions/schema_version" },
        "backend_mode": { "enum": ["real", "mock"] },
        "created": {
          "type": "boolean",
          "description": "true = vừa tạo; false = idempotent replay"
        },
        "case": {
          "$ref": "workspace.schema.json#/definitions/result_data/properties/case"
        },
        "stage": {
          "$ref": "workspace.schema.json#/definitions/result_data/properties/stage"
        },
        "diagram": {
          "$ref": "workspace.schema.json#/definitions/result_data/properties/diagram"
        },
        "capabilities": {
          "$ref": "workspace.schema.json#/definitions/result_data/properties/capabilities"
        },
        "docx_import": {
          "$ref": "common.schema.json#/definitions/docx_import"
        }
      }
    }
  }
}
