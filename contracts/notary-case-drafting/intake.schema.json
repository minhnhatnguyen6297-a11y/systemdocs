{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://systemdocs/contracts/notary-case-drafting/intake.schema.json",
  "title": "notary.intake_analyze — payload + result.data",
  "definitions": {
    "payload": {
      "type": "object",
      "required": ["case_id", "sources"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "common.schema.json#/definitions/intake_source" }
        }
      }
    },
    "result_data": {
      "type": "object",
      "required": ["schema_version", "suggestions", "errors"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/definitions/schema_version" },
        "suggestions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/suggestion" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/intake_error" }
        },
        "breakdown": {
          "type": "object",
          "required": ["succeeded", "failed"],
          "additionalProperties": false,
          "properties": {
            "succeeded": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/definitions/uuid4" }
            },
            "failed": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/definitions/uuid4" }
            }
          },
          "description": "Bắt buộc khi job status = partial (envelope §5): source_id theo nhóm"
        }
      }
    }
  }
}
