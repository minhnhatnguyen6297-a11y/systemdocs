{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zalo-intake:common:v1",
  "title": "Shared definitions for zalo-intake v1 schemas",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "iso_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with explicit offset (Z or +/-HH:MM)"
    },
    "sha256_hex": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]+$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "error_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
