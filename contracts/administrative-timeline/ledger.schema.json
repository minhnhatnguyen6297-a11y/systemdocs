{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:systemdocs:administrative-timeline:1.0",
  "title": "Administrative timeline ledger v1 (local NAIA-9 storage)",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "dataset_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sources"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/units"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/names"
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parents"
      }
    },
    "codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/codes"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mentions"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/events"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observations"
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "dataset_version",
    "coverage",
    "sources",
    "units",
    "names",
    "parents",
    "codes",
    "mentions",
    "events",
    "observations"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "row_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "row_key"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "unit",
            "mention"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "request_body": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[0-9a-f]{64}"
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "provider",
        "url",
        "protocol",
        "request_body",
        "retrieved_at",
        "sha256",
        "snapshot",
        "description"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "level": {
          "enum": [
            "province",
            "district",
            "commune"
          ]
        },
        "source_key": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "evidence",
        "level",
        "source_key"
      ],
      "additionalProperties": false
    },
    "names": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "status": {
          "enum": [
            "confirmed",
            "observed",
            "pending"
          ]
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "evidence",
        "unit_id",
        "valid_from",
        "valid_to",
        "status",
        "event_id",
        "value"
      ],
      "additionalProperties": false
    },
    "parents": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "status": {
          "enum": [
            "confirmed",
            "observed",
            "pending"
          ]
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "evidence",
        "unit_id",
        "valid_from",
        "valid_to",
        "status",
        "event_id",
        "parent_id"
      ],
      "additionalProperties": false
    },
    "codes": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "status": {
          "enum": [
            "confirmed",
            "observed",
            "pending"
          ]
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "evidence",
        "unit_id",
        "valid_from",
        "valid_to",
        "status",
        "event_id",
        "value"
      ],
      "additionalProperties": false
    },
    "mentions": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "raw_phrase": {
          "type": "string",
          "minLength": 1
        },
        "candidate_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolved_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "confirmed"
          ]
        }
      },
      "required": [
        "id",
        "evidence",
        "raw_phrase",
        "candidate_names",
        "resolved_unit_id",
        "status"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "type": {
          "enum": [
            "rename",
            "merge",
            "split",
            "reparent",
            "abolish",
            "reported_transition"
          ]
        },
        "from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "effective_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\d{4}-\\d{2}-\\d{2}"
        },
        "status": {
          "enum": [
            "confirmed",
            "observed",
            "pending"
          ]
        },
        "territory": {
          "enum": [
            "whole",
            "partial",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "evidence",
        "type",
        "from",
        "to",
        "effective_on",
        "valid_from",
        "valid_to",
        "status",
        "territory",
        "notes"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "unchanged",
            "reported_predecessor"
          ]
        },
        "raw_phrase": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "evidence",
        "unit_id",
        "kind",
        "raw_phrase",
        "details",
        "dataset_version"
      ],
      "additionalProperties": false
    }
  }
}
