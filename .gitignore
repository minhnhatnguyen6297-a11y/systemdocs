# Monorepo-level ignores (child repos keep their own .gitignore in subdirs)

# Python
__pycache__/
*.py[cod]
.venv*/
venv/

# Node / Electron
node_modules/
shell/dist/
shell/out/

# Runtime / data — never commit
runtime/
output/
*.db
*.sqlite
*.sqlite3
.env
.env.local
**/engine-roots.json

# OS / editor
Thumbs.db
.DS_Store

# Agent scratch & temp — bãi rác chính thức, không commit
_bmad-output/tmp/
.tmp/
.cache/
logs/
artifacts/

# Local samples and worktree recovery; never commit personal sample data.
