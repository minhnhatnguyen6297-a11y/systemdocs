# Monorepo-level ignores (child repos keep their own .gitignore in subdirs)

# Python
__pycache__/
*.py[cod]
.venv*/
venv/

# Node / Electron
node_modules/
shell/dist/
shell/out/

# Runtime / data — never commit
runtime/
output/
*.db
*.sqlite
*.sqlite3
.env
.env.local
**/engine-roots.json

# OS / editor
Thumbs.db
.DS_Store

# Agent scratch & temp — bãi rác chính thức, không commit
_bmad-output/tmp/
.tmp/
.cache/
logs/
artifacts/

# Generated BMAD workflow snapshots and packed example output
_bmad/render/
_bmad/custom/html-plan/examples/*.packed.html

# Local samples and worktree recovery; never commit personal sample data.

# graphify machine-local + intermediate (commit only graph.json, GRAPH_REPORT.md, manifest.json, .graphify_analysis.json)
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/.graphify_detect.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_extract.json

