                     check_cancel: Optional[Callable[[dict], None]] = None,
                     report_progress: Optional[Callable] = None,
                     today: Any = None,
                     doc_specs: Optional[list[WordDocumentSpec]] = None,
                     create_case_subdir: bool = False) -> dict:
