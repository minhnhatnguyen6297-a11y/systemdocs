        _check()                                       # cancel trước khi probe
        dest_error: Optional[tuple[str, str]] = None
        try:
            _probe_dest_writable(dest_dir)
        except FileNotFoundError as exc:
            dest_error = ("file_not_found",
                          f"destination không còn tồn tại: {exc}")
